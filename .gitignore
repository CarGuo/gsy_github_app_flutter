.DS_Store
.dart_tool/

.packages
.pub/

build/

.flutter-plugins
.flutter-plugins-dependencies

.gradle/

ignoreConfig.dart

flutter_export_environment.sh

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
patrol_test/test_bundle.dart

.pub-cache/
/build/

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# FVM Version Cache
.fvm/
env.local

# 一次性 debug 截图/证据（脚本本身仍要进仓库，只忽略产物）
tool/dbg/*.png
tool/dbg/*.jpg
tool/dbg/*.txt
tool/dbg/*.log
tool/dbg/*.json
tool/dbg/*.xml
tool/dbg/*.html
tool/dbg/*.md
tool/dbg/*.py
tool/dbg/**/*.png
tool/dbg/**/*.jpg
tool/dbg/**/*.txt
tool/dbg/**/*.log
tool/dbg/**/*.json
tool/dbg/**/*.xml
tool/dbg/**/*.html
tool/dbg/**/*.md
tool/dbg/**/*.py
# 一次性 dart 排查脚本（例如依赖升级期抓 widget tree 的 dump 脚本），
# 与 tool/dbg/ 其它产物同类，不进仓库
tool/dbg/**/*.dart

# 冒烟证据：脚本每次跑都会往 tool/ai/smoke/evidence/<yyyymmdd_hhmm>/ 落 5 张
# 截图 + logcat，属于产物类不进仓库；脚本本身照常提交
tool/ai/smoke/evidence/
# 冒烟脚本 ad-hoc 输出（P2 期开始把散图暂放 tool/ai/smoke/artifacts/ 及根目录，
# 需要跟 evidence/ 一样只保留脚本 + 说明文档，不进仓库产物）
tool/ai/smoke/artifacts/
tool/ai/smoke/*.png
tool/ai/smoke/*.jpg
tool/ai/smoke/*.xml
tool/ai/smoke/*.txt
tool/ai/smoke/*.log
# mcp_dart / vm_service 会话中间产物（isolate / vm dump 之类的 json），
# 与 evidence/ 同类，只保留脚本 + 说明文档
tool/ai/smoke/logs/
.t-env.txt

# 本地 reviewer subagent 中间产物（`git diff > .review_*.diff` 之类）
.review_*.diff
.review_*.txt

# IDE 工作区（Trae / Cursor）
.trae/

# 单次调试档：`debug-<slug>.md` 是 author 本地记录，可选转成 `docs/` 后再进仓库
debug-*.md